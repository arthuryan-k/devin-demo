{
  "name": "@devin-demo/gateway",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "description": "Public gateway/BFF: auth, admission control, synchronous risk, command publish and event correlation",
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/http-proxy": "^11.6.5",
    "fastify": "^5.12.7",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@types/node": "^20.19.43",
    "eslint": "~9.39.0",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~15.15.0",
    "prettier": "~3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.50.0",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "overrides": {
    "cookie": "^1.0.2"
  }
}
