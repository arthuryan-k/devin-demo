{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "User signup/login (JWT), per-participant API keys, persisted in Postgres",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~17.13.0",
    "prettier": "~3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "~8.72.0",
    "vitest": "^5.0.5"
  }
}
