{
  "name": "reference-data-service",
  "version": "0.1.0",
  "private": true,
  "description": "Serves the listed symbols and their trading parameters from Postgres",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "lodash": "4.17.20",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "~9.39.0",
    "eslint-config-prettier": "~10.1.8",
    "globals": "~15.15.0",
    "prettier": "~3.6.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.50.0",
    "vitest": "^5.0.5"
  }
}
